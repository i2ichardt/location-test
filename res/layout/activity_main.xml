<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F1EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location Test"
            android:textColor="#1A1916"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="18dp"
            android:text="Talks to the Windows server on port 8000. Same Wi-Fi uses the PC’s LAN address. Anywhere else, use its Tailscale address."
            android:textColor="#5C584F"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/field_bg"
            android:hint="Server URL  (http://100.x.x.x:8000)"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#1A1916"
            android:textColorHint="#8A8478"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/field_bg"
            android:hint="User ID"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="Alice"
            android:textColor="#1A1916"
            android:textColorHint="#8A8478"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/field_bg"
            android:hint="Group ID"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="Fam1"
            android:textColor="#1A1916"
            android:textColorHint="#8A8478"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editLat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="Latitude"
                android:inputType="numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="42.3601"
                android:textColor="#1A1916"
                android:textColorHint="#8A8478"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editLon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="Longitude"
                android:inputType="numberDecimal|numberSigned"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="-71.0589"
                android:textColor="#1A1916"
                android:textColorHint="#8A8478"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            android:text="Sample pin filled in. Use this phone replaces it with a real fix."
            android:textColor="#8A8478"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonHere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="48dp"
            android:text="Use this phone"
            android:textAllCaps="false"
            android:textColor="#243E4A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="48dp"
            android:text="Check server"
            android:textAllCaps="false"
            android:textColor="#243E4A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_primary"
            android:minHeight="48dp"
            android:text="Send location"
            android:textAllCaps="false"
            android:textColor="#F3F1EB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonFetch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_primary"
            android:minHeight="48dp"
            android:text="Fetch location"
            android:textAllCaps="false"
            android:textColor="#F3F1EB"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/status_bg"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="Status will appear here."
            android:textColor="#1A1916"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
