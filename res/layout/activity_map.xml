<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7E2D6">

    <WebView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/satelliteButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/btn_secondary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Satellite"
            android:textAllCaps="false"
            android:textColor="#1A1916"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_primary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="#F4F1EA"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/status_bg"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:text="Looking for the server"
        android:textColor="#1A1916"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F7F4EE"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="People in your group"
                android:textColor="#1A1916"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <LinearLayout
                    android:id="@+id/peopleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <Button
            android:id="@+id/peopleTab"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1A1916"
            android:text="People"
            android:textAllCaps="false"
            android:textColor="#F4F1EA"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
