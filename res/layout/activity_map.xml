<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7E2D6">

    <WebView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/satelliteButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill_light"
            android:stateListAnimator="@null"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Satellite"
            android:textAllCaps="false"
            android:textColor="#1C1B19"
            android:textSize="14sp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill_dark"
            android:stateListAnimator="@null"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="#F7F4EE"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/status_bg"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:text="Looking for the server"
        android:textColor="#1A1916"
        android:textSize="13sp" />

    <com.family.locationtest.SwipeCard
        android:id="@+id/personCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#1C1B19"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardArrived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:paddingTop="4dp"
            android:scrollHorizontally="false"
            android:singleLine="false"
            android:textColor="#5C584F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cardStay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:scrollHorizontally="false"
            android:singleLine="false"
            android:textColor="#5C584F"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cardView"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_light"
                android:stateListAnimator="@null"
                android:text="Directions"
                android:textAllCaps="false"
                android:textColor="#1C1B19" />

            <Button
                android:id="@+id/cardCall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_light"
                android:stateListAnimator="@null"
                android:text="Call"
                android:textAllCaps="false"
                android:textColor="#1C1B19" />

            <Button
                android:id="@+id/cardText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/pill_dark"
                android:stateListAnimator="@null"
                android:text="Text"
                android:textAllCaps="false"
                android:textColor="#F7F4EE" />
        </LinearLayout>
    </com.family.locationtest.SwipeCard>

    <com.family.locationtest.CurtainSheet
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_bg"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/peopleTab"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:background="@drawable/grabber" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="People"
                android:textColor="#1A1916"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/peopleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="People in your group"
            android:textColor="#1A1916"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/peopleScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/peopleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </com.family.locationtest.CurtainSheet>
</FrameLayout>
